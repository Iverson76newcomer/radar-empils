// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Полевые наблюдения от сотрудников (РМ, ЭТП, мерчендайзеров)
model RadarMessage {
  id          String   @id @default(cuid())
  category    String   // competitors | product | idea | problem | trend
  text        String   // текст сообщения
  region      String   // регион сотрудника
  authorName  String   // имя сотрудника
  authorRole  String   // role: RM | ETP | merchandiser
  photoUrl    String?  // URL фото (base64 или ссылка)
  status      String   @default("new") // new | accepted | in_progress | closed | rejected
  managerNote String?  // комментарий руководителя
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Сотрудники
model Employee {
  id        String   @id @default(cuid())
  name      String   // ФИО
  role      String   // RM | ETP | merchandiser
  region    String   // регион
  pin       String   // PIN-код для авторизации
  createdAt DateTime @default(now())
}
