ton>\n                            </div>\n                        </div>\n                    </form>\n                </div>\n            </div>\n            <div class=\"modal-footer\" style=\"background-color: #eee; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; border-top: none; padding: 3px;\"></div>\n        </div><!-- /.modal-content -->\n    </div><!-- /.modal-dialog -->\n</div><!-- /.modal -->\n\n<!-- диалоговое окно быстрой покупки -->\n<div id=\"quickBuyDialog\" class=\"modal fade\" tabindex=\"-1\" role=\"dialog\">\n    <div class=\"modal-dialog\" role=\"document\">\n        <form class=\"modal-content\" action=\"/buy/\" method=\"post\" onsubmit=\"return checkBuyUserEmail()\">\n            <div class=\"modal-header\">\n                <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\"><span aria-hidden=\"true\">×</span></button>\n                <h4 class=\"modal-title\">Покупка физлицом</h4>\n            </div>\n            <div class=\"modal-body\">\n                <div class=\"alert alert-danger\" role=\"alert\" id=\"wrongUserEmailError\">Введите валидный email!</div>\n                <div class=\"flex flex-ver-start flex-col\">\n                    <div class=\"form-group full\">\n                        <label class=\"sr-only\" for=\"priceTblUserEmail\">E-mail</label>\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <input type=\"email\" name=\"email\" class=\"form-control\" id=\"priceTblUserEmail\" value=\"\" placeholder=\"Введите e-mail\">\n                                <p class=\"help-block\">На этот e-mail после оплаты будет выслан купон (код) для просмотра анализа фирм за последний доступный год.</p>\n                                <input type=\"hidden\" name=\"code\" id=\"priceTblUserCode\" value=\"\">\n                                <input type=\"hidden\" name=\"inn\" id=\"priceTblUserInn\" value=\"\">\n  