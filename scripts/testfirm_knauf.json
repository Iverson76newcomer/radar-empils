let items = JSON.parse(savedRecordsJson) || [];\n        if (items.length > 0) {\n            let x = input.offsetLeft, y = input.offsetTop + 38;\n            let box = document.createElement('ul');\n            box.setAttribute('id', 'searchTipsBox');\n            box.style.left = x + 'px';\n            box.style.top = y + 'px';\n            box.style.zIndex = '9999';\n            \n            for (let item of items) {\n                let li = document.createElement('li'), text = document.createTextNode(item);\n                li.appendChild(text);\n                li.addEventListener('click', function(e) {\n                    e.preventDefault();\n                    input.value = item;\n                });\n                box.appendChild(li);\n            }\n            input.parentNode.insertBefore(box, input);\n        }\n    }\n}\n\nfunction saveRequest(text) {\n    if (text.length > 3) {\n        let searchBox = window.localStorage.getItem('searchForm') ? JSON.parse(window.localStorage.getItem('searchForm').toString()) : [];\n        let found = false;\n        for (let i in searchBox) {\n            if (text.toLowerCase() === searchBox[i].toLowerCase()) {\n                searchBox[i] = text;\n                if (i > 0) {\n                    let j = i;\n                    while (j > 0) {\n                        let tmp = searchBox[j-1];\n                        searchBox[j-1] = searchBox[j];\n                        searchBox[j] = tmp;\n                        j--;\n                    }\n                }\n                found = true;\n                break;\n            }\n        }\n        if (!found) {\n            searchBox.unshift(text);\n        }\n        \n        while (searchBox.length > 7) {\n            searchBox.pop();\n        }\n        \n        window.localStorage.setItem('searchForm', JSON.stringify(searchBox));\n    }\n}\n\n/* аналог document.ready */\ndocument.addEventListener('DOMContentLoaded', function(event) { \n    let form = document.getElementById('searchForm');\n    form.addEventListener('submit', function() {\n        for (let name of window.tooltipFields) {\n            let input = document.querySelector('input[name='+ name +']');\n            if (input.value !== '') {\n                saveRequest(input.value);\n            }\n        }\n    });\n    \n    for (let name of window.tooltipFields) {\n        let input = document.querySelector('input[name='+ name +']');\n        input.addEventListener('focus', function() { showTooltips(input); });\n        input.addEventListener('blur', function() { hideTooltips(); });\n    }\n});\n</script>\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"sec\">\n\t\t\t<div class=\"container\">\n\t\t\t\t<h1>Страница, которую вы запросили, не существует.</h1><br>\n\t\t\t\t<p>\n\t\t\t\t\tНо вы можете:\n\t\t\t\t\t</p><ul class=\"error-page-list\">\n\t\t\t\t\t\t<li><a href=\"/\">Сравнить финансовое состояние фирмы с отраслевыми показателями и конкурентами</a></li>\n\t\t\t\t\t\t<li><a href=\"/rating/\">Узнать рейтинг организаций по выручке</a></li>\n\t\t\t\t\t\t<li><a href=\"/otrasli/\">Ознакомиться со справочником отраслевых финансовых показателей</a></li>\n\t\t\t\t\t</ul>\n\t\t\t\t<p></p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div id=\"footer-clear\"></div>\n</div>\n\n<div style=\"margin-bottom: 14px; max-height:300px; height:auto; text-align:center;\" class=\"myresponsive\" id=\"yandex_rtb_R-A-279343-4\" data-a3c8256513=\"\"></div>\n<script>window.yaContextCb.push(()=>{\n  Ya.Context.AdvManager.render({\n    renderTo: 'yandex_rtb_R-A-279343-4',\n    blockId: 'R-A-279343-4',\n  })\n});\nmy_RTBreload('yandex_rtb_R-A-279343-4', 'R-A-279343-4', 30);\n</script><footer id=\"footer\">\n    <div class=\"container flex flex-ver-start flex-between flex-wrap\">\n        <div class=\"copyright\">\n            © <a href=\"https://www.audit-it.ru\" target=\"_blank\">Audit-it.ru</a>, 2017 ‐ 2026 \n        </div>\n        <div class=\"f-menu\">\n            <ul class=\"line